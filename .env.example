# Copy this file to `.env.local` and fill in the values.
# `.env.local` is gitignored — never commit real secrets.
# Variables are validated by src/env.ts at build & runtime.

# Public base URL of the site (used by sitemap.ts / robots.ts).
# In production on Vercel, set this to your real domain.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Server-only secrets (examples, uncomment in src/env.ts when needed) ---
# RESEND_API_KEY=
